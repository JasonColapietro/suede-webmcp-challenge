{
  "name": "suede-agent-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "check:play-billing": "node scripts/check-play-billing-contract.mjs",
    "prebuild": "npm run check:play-billing",
    "build": "next build",
    "lint": "eslint . --max-warnings 0",
    "start": "next start",
    "worker": "node scripts/run-runtime-worker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:phase0": "node scripts/verify-phase-0.mjs",
    "verify:phase1": "node scripts/verify-phase-1.mjs",
    "verify:phase2a": "node scripts/verify-phase-2a.mjs",
    "verify:phase2b": "node scripts/verify-phase-2b.mjs",
    "verify:phase2c": "node scripts/verify-phase-2c.mjs",
    "verify:phase2d": "node scripts/verify-phase-2d.mjs",
    "verify:phase2d:subflows": "node scripts/verify-phase-2d-subflows.mjs",
    "verify:phase2e": "node scripts/verify-phase-2e.mjs",
    "verify:phase2f": "node scripts/verify-phase-2f.mjs",
    "verify:phase3a": "node scripts/verify-phase-3a.mjs",
    "verify:phase4a": "node scripts/verify-phase-4a.mjs",
    "verify:phase4b1": "node scripts/verify-phase-4b1.mjs",
    "verify:card-payment": "node scripts/verify-card-payment.mjs",
    "verify:prospect-production": "RUN_PROSPECT_PRODUCTION_CANARY=1 vitest run tests/db/prospect-engine-production-canary.test.ts",
    "capture:phase0": "node scripts/capture-phase-0.mjs",
    "capture:phase0:server": "node scripts/start-phase-0-capture.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.3.24",
    "@fontsource/instrument-serif": "^5.2.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@types/pdfkit": "^0.17.6",
    "@xyflow/react": "^12.3.0",
    "ai": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "botid": "^1.5.11",
    "exceljs": "^4.4.0",
    "geist": "^1.7.2",
    "jose": "^5.9.0",
    "mammoth": "^1.12.0",
    "next": "^15.1.0",
    "pdfkit": "^0.19.1",
    "posthog-js": "^1.393.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.2",
    "undici": "^6.28.0",
    "unpdf": "^1.6.2",
    "viem": "^2.55.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
