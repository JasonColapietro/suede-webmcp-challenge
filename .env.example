# Safe local defaults. Copy to .env.local and add secrets there; never commit them.
DB_DRIVER=sqlite
SQLITE_PATH=studio.db
DEV_OWNER_ID=dev-user

# Resource Foundry is enabled unless this emergency stop is exactly 0.
# This is the only Resource Foundry feature control; creation and testing are
# not entitlement-gated.
RESOURCE_FOUNDRY_ENABLED=1

# Local runs remain no-spend unless an operator separately configures and
# authorizes settlement.
X402_SKIP_SETTLEMENT=true
AP2_MODE=off

# Optional provider and hosted-persistence configuration.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AGENT_STUDIO_DB_SECRET=
