# Release signing for ai.suede.agents.
#
# Copy to `keystore.properties` in this same directory (ios-app/android/) and
# fill in the real values. That filename is git-ignored — never commit it, and
# never commit the .jks itself.
#
#   cp keystore.properties.example keystore.properties
#
# When this file is absent, app/build.gradle leaves the release build type
# UNSIGNED rather than failing, so a debug-only checkout and CI without secrets
# both still build.
#
# READ docs/play-store/BLOCKERS.md FIRST. As of 2026-08-08 no upload keystore
# exists for this package anywhere on the build machine. Do NOT generate one
# before confirming in Play Console -> Test and release -> Setup -> App signing
# whether an upload certificate is already enrolled. Signing an AAB with the
# wrong key produces an artifact Play rejects at upload, and that mistake has
# already been made twice in this estate.
#
# Back up the .jks outside any git worktree once it exists — see
# ~/Documents/android-upload-keystores/README.md. An upload key is not
# recoverable; losing it means a Google support request.

storeFile=/absolute/path/to/suede-agent-studio-upload.jks
storePassword=CHANGE_ME
keyAlias=suede-agent-studio-upload
keyPassword=CHANGE_ME
